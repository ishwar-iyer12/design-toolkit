{
  "name": "showcase",
  "extends": "base",
  "description": "Pages that have to be remembered. Depth, a display typeface with character, one supporting colour, and a signature animation.",
  "color": {
    "note": "Choose the accent and the support colour from the concept, then check contrast. These are defaults, not the answer.",
    "accent": {
      "50": "#ecf4f0",
      "100": "#d3e6dd",
      "600": "#14342b",
      "700": "#0e2720",
      "800": "#091a15"
    },
    "support": {
      "100": "#fde6dc",
      "300": "#f4b8a0",
      "600": "#8f3b1b"
    },
    "role": {
      "page": "#faf8f4",
      "accent": "{color.accent.600}",
      "accent-hover": "{color.accent.700}",
      "accent-pressed": "{color.accent.800}",
      "focus-ring": "{color.accent.600}",
      "support-fill": "{color.support.300}",
      "support-text": "{color.support.600}"
    }
  },
  "font": {
    "pairings": [
      {
        "display": "'Archivo', system-ui, sans-serif",
        "body": "'Work Sans', system-ui, sans-serif",
        "mood": "sturdy, plain-spoken, good for tools and trades"
      },
      {
        "display": "'Fraunces', Georgia, serif",
        "body": "'Inter', system-ui, sans-serif",
        "mood": "warm, literary, good for craft and food"
      },
      {
        "display": "'Space Grotesk', system-ui, sans-serif",
        "body": "'IBM Plex Sans', system-ui, sans-serif",
        "mood": "technical, precise, good for developer tools"
      },
      {
        "display": "'DM Serif Display', Georgia, serif",
        "body": "'DM Sans', system-ui, sans-serif",
        "mood": "editorial, calm, good for finance and health"
      }
    ],
    "size": {
      "caption": "14px",
      "body": "18px",
      "lead": "22px",
      "title": "40px",
      "display": "88px"
    },
    "line-height": {
      "caption": "20px",
      "body": "28px",
      "lead": "32px",
      "title": "44px",
      "display": "88px"
    },
    "letter-spacing": {
      "display": "-0.03em",
      "title": "-0.02em"
    },
    "display-small-screen": "48px"
  },
  "size": {
    "control": {
      "medium": "44px",
      "large": "52px"
    },
    "content-max": "1200px",
    "measure": "60ch"
  },
  "section": {
    "gap": "128px",
    "gap-small-screen": "64px",
    "heading-to-body": "16px",
    "body-to-action": "32px"
  },
  "depth": {
    "perspective": "1200px",
    "layer": {
      "rest": "0px",
      "low": "24px",
      "mid": "48px",
      "high": "96px"
    },
    "tilt-max": "8deg",
    "rest-pose-rotation-min": "15deg",
    "rest-pose-rotation-max": "35deg",
    "signature-width-min": "40%"
  },
  "shadow": {
    "none": "none",
    "low": "0 1px 2px rgba(14, 14, 13, 0.08), 0 4px 8px rgba(14, 14, 13, 0.06)",
    "mid": "0 2px 4px rgba(14, 14, 13, 0.08), 0 12px 24px rgba(14, 14, 13, 0.10)",
    "high": "0 4px 8px rgba(14, 14, 13, 0.08), 0 32px 64px rgba(14, 14, 13, 0.16)",
    "hard": "8px 8px 0 {color.role.support-fill}"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "base": "160ms",
      "slow": "240ms",
      "beat": "600ms",
      "scene": "1200ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "settle": "cubic-bezier(0.16, 1, 0.3, 1)",
      "overshoot": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "stagger": "60ms",
    "stagger-total-max": "400ms",
    "signature-beats-max": 3
  },
  "hierarchy": {
    "primary-actions-per-screen": 1,
    "accent-uses-max": 3,
    "support-colour-uses-max": 2,
    "display-uses-per-page": 1,
    "signature-animations-per-page": 1
  },
  "effects": {
    "gradients": false,
    "glass": false,
    "shadows": "depth layers (low, mid, high) on things that sit above the page, and one hard offset shadow as a motif",
    "3d": true
  }
}
