{
  "name": "marketing",
  "extends": "base",
  "description": "Landing pages. A concept, a typeface with character, strong hierarchy, one accent and one support colour, generous vertical rhythm.",
  "color": {
    "accent": {
      "50": "#fff4ed",
      "100": "#ffe6d5",
      "600": "#b93a0a",
      "700": "#962f08",
      "800": "#742406"
    },
    "role": {
      "accent": "{color.accent.600}",
      "accent-hover": "{color.accent.700}",
      "accent-pressed": "{color.accent.800}",
      "focus-ring": "{color.accent.600}",
      "page": "#fbfaf7",
      "support-fill": "{color.support.300}",
      "support-text": "{color.support.600}"
    },
    "note": "Choose the accent and the support colour from the concept, then check contrast. These are defaults, not the answer.",
    "support": {
      "100": "#e6f0ea",
      "300": "#b9d8c6",
      "600": "#2f6b4f"
    }
  },
  "font": {
    "size": {
      "caption": "14px",
      "body": "18px",
      "lead": "22px",
      "title": "36px",
      "display": "80px"
    },
    "line-height": {
      "caption": "20px",
      "body": "28px",
      "lead": "32px",
      "title": "44px",
      "display": "80px"
    },
    "letter-spacing": {
      "display": "-0.035em",
      "title": "-0.02em",
      "label": "0.08em"
    },
    "display-small-screen": "44px",
    "pairings": [
      {
        "display": "'Archivo', system-ui, sans-serif",
        "body": "'Work Sans', system-ui, sans-serif",
        "mood": "sturdy, plain-spoken, good for tools and trades"
      },
      {
        "display": "'Fraunces', Georgia, serif",
        "body": "'Inter', system-ui, sans-serif",
        "mood": "warm, literary, good for craft and food"
      },
      {
        "display": "'Space Grotesk', system-ui, sans-serif",
        "body": "'IBM Plex Sans', system-ui, sans-serif",
        "mood": "technical, precise, good for developer tools"
      },
      {
        "display": "'DM Serif Display', Georgia, serif",
        "body": "'DM Sans', system-ui, sans-serif",
        "mood": "editorial, calm, good for finance and health"
      }
    ],
    "label": "'IBM Plex Mono', ui-monospace, monospace",
    "weight": {
      "regular": "400",
      "medium": "500",
      "bold": "700",
      "display": "800"
    }
  },
  "size": {
    "control": {
      "medium": "44px",
      "large": "52px"
    },
    "content-max": "1120px",
    "measure": "60ch"
  },
  "section": {
    "gap": "96px",
    "gap-small-screen": "64px",
    "gap-after-hero": "128px",
    "heading-to-body": "16px",
    "body-to-action": "32px"
  },
  "hierarchy": {
    "primary-actions-per-screen": 1,
    "accent-uses-max": 3,
    "display-uses-per-page": 1,
    "support-colour-uses-max": 3
  },
  "effects": {
    "gradients": false,
    "glass": false,
    "shadows": "the product view in the hero (product), one hard offset shadow as a motif (hard), floating layers (low)"
  },
  "shadow": {
    "none": "none",
    "low": "0 1px 2px rgba(14, 14, 13, 0.08), 0 4px 8px rgba(14, 14, 13, 0.06)",
    "product": "0 2px 4px rgba(14, 14, 13, 0.08), 0 24px 48px rgba(14, 14, 13, 0.14)",
    "hard": "8px 8px 0 {color.role.support-fill}"
  },
  "hero": {
    "product-view-width-min": "45%",
    "headline-lines-max": 3
  }
}
