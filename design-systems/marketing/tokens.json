{
  "name": "marketing",
  "extends": "base",
  "description": "Landing pages. Strong hierarchy, one accent, generous vertical rhythm.",
  "color": {
    "accent": {
      "50": "#fff4ed",
      "100": "#ffe6d5",
      "600": "#b93a0a",
      "700": "#962f08",
      "800": "#742406"
    },
    "role": {
      "accent": "{color.accent.600}",
      "accent-hover": "{color.accent.700}",
      "accent-pressed": "{color.accent.800}",
      "focus-ring": "{color.accent.600}"
    }
  },
  "font": {
    "size": {
      "caption": "14px",
      "body": "18px",
      "lead": "22px",
      "title": "36px",
      "display": "64px"
    },
    "line-height": {
      "caption": "20px",
      "body": "28px",
      "lead": "32px",
      "title": "44px",
      "display": "68px"
    },
    "letter-spacing": {
      "display": "-0.02em",
      "title": "-0.01em"
    },
    "display-small-screen": "40px"
  },
  "size": {
    "control": {
      "medium": "44px",
      "large": "52px"
    },
    "content-max": "1120px",
    "measure": "60ch"
  },
  "section": {
    "gap": "96px",
    "gap-small-screen": "64px",
    "gap-after-hero": "128px",
    "heading-to-body": "16px",
    "body-to-action": "32px"
  },
  "hierarchy": {
    "primary-actions-per-screen": 1,
    "accent-uses-max": 3,
    "display-uses-per-page": 1
  },
  "effects": {
    "gradients": false,
    "glass": false,
    "shadows": "floating layers only (popover, modal)"
  }
}
