{
  "name": "base",
  "description": "Default tokens. Every variant starts here and overrides only what it needs.",
  "color": {
    "neutral": {
      "0": "#ffffff",
      "50": "#fafaf9",
      "100": "#f4f4f2",
      "200": "#e6e5e2",
      "300": "#d2d1cc",
      "400": "#a3a29c",
      "500": "#76756f",
      "600": "#5c5b56",
      "700": "#43423e",
      "800": "#2a2a27",
      "900": "#1a1a18",
      "950": "#0e0e0d"
    },
    "accent": {
      "50": "#eef4fb",
      "100": "#d9e6f5",
      "200": "#b3cdeb",
      "300": "#82acdc",
      "400": "#4f86c6",
      "500": "#2f69ad",
      "600": "#22548f",
      "700": "#1c4473",
      "800": "#17375c",
      "900": "#122a46"
    },
    "danger": {
      "100": "#fbe4e1",
      "600": "#b3261e",
      "700": "#8c1d18"
    },
    "warning": {
      "100": "#fdf0d5",
      "600": "#8a5a00",
      "700": "#6b4500"
    },
    "success": {
      "100": "#dff3e4",
      "600": "#1e7a3c",
      "700": "#175e2e"
    },
    "role": {
      "page": "{color.neutral.0}",
      "surface": "{color.neutral.50}",
      "surface-sunken": "{color.neutral.100}",
      "border": "{color.neutral.200}",
      "border-strong": "{color.neutral.500}",
      "text": "{color.neutral.900}",
      "text-muted": "{color.neutral.600}",
      "text-disabled": "{color.neutral.400}",
      "text-on-accent": "{color.neutral.0}",
      "accent": "{color.accent.600}",
      "accent-hover": "{color.accent.700}",
      "accent-pressed": "{color.accent.800}",
      "focus-ring": "{color.accent.500}"
    }
  },
  "font": {
    "family": {
      "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, monospace"
    },
    "size": {
      "caption": "12px",
      "body": "15px",
      "lead": "18px",
      "title": "24px",
      "display": "36px"
    },
    "line-height": {
      "caption": "16px",
      "body": "24px",
      "lead": "28px",
      "title": "32px",
      "display": "40px"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "bold": "650"
    }
  },
  "space": {
    "hair": "4px",
    "tight": "8px",
    "snug": "12px",
    "base": "16px",
    "roomy": "24px",
    "wide": "32px",
    "section": "48px",
    "block": "64px",
    "page": "96px"
  },
  "radius": {
    "none": "0px",
    "small": "2px",
    "medium": "6px",
    "large": "10px",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "popover": "0 4px 12px rgba(14, 14, 13, 0.12)",
    "modal": "0 16px 40px rgba(14, 14, 13, 0.20)"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "base": "160ms",
      "slow": "240ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "size": {
    "control": {
      "small": "28px",
      "medium": "36px",
      "large": "44px"
    },
    "hit-target-min": "44px",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px",
    "measure": "68ch"
  },
  "effects": {
    "gradients": false,
    "glass": false,
    "shadows": "floating layers only (popover, modal)"
  }
}
