{
  "name": "dashboard",
  "extends": "base",
  "description": "Dense data UI for people who use it all day with a pointer and a keyboard.",
  "font": {
    "size": {
      "caption": "11px",
      "body": "13px",
      "lead": "15px",
      "title": "18px",
      "display": "28px"
    },
    "line-height": {
      "caption": "16px",
      "body": "20px",
      "lead": "20px",
      "title": "24px",
      "display": "32px"
    },
    "numeric": "tabular-nums lining-nums"
  },
  "size": {
    "control": {
      "small": "24px",
      "medium": "28px",
      "large": "32px"
    },
    "hit-target-min": "24px"
  },
  "table": {
    "row-height": {
      "compact": "28px",
      "default": "32px",
      "relaxed": "40px"
    },
    "cell-padding-x": "8px",
    "header-height": "32px",
    "align": {
      "text": "left",
      "number": "right",
      "date": "left",
      "status": "left",
      "action": "right"
    }
  },
  "radius": {
    "medium": "4px",
    "large": "6px"
  },
  "chart": {
    "categorical": [
      "#0072B2",
      "#E69F00",
      "#009E73",
      "#CC79A7",
      "#56B4E9",
      "#D55E00"
    ],
    "max-series": 6,
    "sequential": [
      "#d9e6f5",
      "#b3cdeb",
      "#82acdc",
      "#4f86c6",
      "#22548f",
      "#122a46"
    ],
    "diverging": {
      "negative": "#D55E00",
      "midpoint": "#e6e5e2",
      "positive": "#0072B2"
    },
    "grid-line": "{color.neutral.200}",
    "axis-text": "{color.neutral.600}",
    "line-width": "2px",
    "gap-between-marks": "2px"
  },
  "effects": {
    "gradients": false,
    "glass": false,
    "shadows": "floating layers only (popover, modal)"
  }
}
