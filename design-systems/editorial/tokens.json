{
  "name": "editorial",
  "extends": "base",
  "description": "Long-form reading. Overrides base where reading comfort needs it.",
  "color": {
    "role": {
      "page": "#fbfaf7",
      "text": "#1f1d1a",
      "text-muted": "#5f5a52",
      "accent": "#7a2e1d",
      "accent-hover": "#5e2316",
      "focus-ring": "#7a2e1d"
    }
  },
  "font": {
    "family": {
      "body": "'Source Serif 4', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
      "heading": "'Source Serif 4', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
      "ui": "'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "size": {
      "caption": "14px",
      "body": "19px",
      "lead": "23px",
      "title": "30px",
      "display": "44px"
    },
    "line-height": {
      "caption": "20px",
      "body": "30px",
      "lead": "34px",
      "title": "38px",
      "display": "50px"
    },
    "weight": {
      "regular": "400",
      "medium": "600",
      "bold": "700"
    }
  },
  "size": {
    "measure": "66ch",
    "measure-min": "45ch",
    "measure-max": "75ch"
  },
  "rhythm": {
    "baseline": "30px",
    "paragraph-gap": "30px",
    "heading-gap-above": "60px",
    "heading-gap-below": "16px",
    "figure-gap": "48px",
    "blockquote-indent": "24px"
  },
  "radius": {
    "medium": "2px",
    "large": "2px"
  },
  "effects": {
    "gradients": false,
    "glass": false,
    "shadows": "none"
  }
}
